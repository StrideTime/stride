## Typography

All visible text goes through `<Typography>`:

```typescript
import { Typography } from '@stride/ui';

// CORRECT
<Typography as="h1" size="2xl" weight="semibold">Backlog</Typography>
<Typography as="p" size="sm" color="muted">3 specs need refinement</Typography>

// WRONG
<h1 style={{ fontSize: 24 }}>Backlog</h1>
<p className="text-gray-500">3 specs need refinement</p>
```

---

## i18n

All user-facing strings live in `en.json`. Never hardcode strings in components:

```typescript
import { useTranslation } from 'react-i18next';

export function SpecCard({ spec }: SpecCardProps) {
  const { t } = useTranslation();
  return (
    <div aria-label={t('spec.card.ariaLabel', { title: spec.title })}>
      <Typography>{t('spec.status.needsRefinement')}</Typography>
    </div>
  );
}
```

```json
{
  "spec": {
    "card": {
      "ariaLabel": "Spec: {{title}}"
    },
    "status": {
      "needsRefinement": "Needs refinement"
    }
  }
}
```

